function TPrincipal.ValidarInfraestrutura(pdv, cpu, disco: Integer;
  memoria: Double; out Mensagem: string): Boolean;
var
  minCPU, minMemoria, minDisco: Integer;
begin
  Result := False;
  Mensagem := '';

  // 1. Identifica faixa de PDVs e define os requisitos mínimos
  if (pdv >= 1) and (pdv <= 100) then
  begin
    minCPU := 6;
    minMemoria := 4;
    minDisco := 128;
  end
  else if (pdv <= 200) then
  begin
    minCPU := 8;
    minMemoria := 8;
    minDisco := 256;
  end
  else if (pdv <= 600) then
  begin
    minCPU := 16;
    minMemoria := 16;
    minDisco := 512;
  end
  else if (pdv <= 1000) then
  begin
    minCPU := 24;
    minMemoria := 16;
    minDisco := 1024;
  end
  else if (pdv <= 1500) then
  begin
    minCPU := 32;
    minMemoria := 24;
    minDisco := 1024;
  end
  else if (pdv <= 2000) then
  begin
    minCPU := 48;
    minMemoria := 32;
    minDisco := 1536;
  end
  else
  begin
    Mensagem := 'PDV fora da regra de infraestrutura.';
    Exit;
  end;

  // 2. Valida cada requisito individualmente

  if cpu < minCPU then
  begin
    Mensagem := Mensagem +
      Format('CPU insuficiente, mínimo recomendado: %d núcleos, atual : %d núcleos.',
      [minCPU, cpu]);
  end;

  if memoria < minMemoria then
  begin
    if Mensagem <> '' then
      Mensagem := Mensagem + sLineBreak;

    Mensagem := Mensagem +
      Format('Memória RAM insuficiente, mínimo recomendado: %d GB. atual : %.1f GB.',
      [minMemoria, memoria]);

  end;

  if disco < minDisco then
  begin
    if Mensagem <> '' then
      Mensagem := Mensagem + sLineBreak;

    Mensagem := Mensagem +
      Format('Espaço livre em disco inferior ao recomendado, mnimo recomendado: %d GB, atual: %d GB.',
      [minDisco, disco]);

  end;

  // 3. Se nenhuma mensagem de erro foi gerada, infraestrutura está OK
  Result := Mensagem = '';

  if Result then
    Mensagem := 'Infraestrutura OK.';
end;

