function TPrincipal.GetTNSNamesPath: string;
var
  Reg: TRegistry;
  SubKeyNames: TStringList;
  Name: string;
begin
  Reg := TRegistry.Create;
  Try
    Reg.RootKey := HKEY_LOCAL_MACHINE;
    Reg.OpenKeyReadOnly('SOFTWARE\ORACLE');
    SubKeyNames := TStringList.Create;
    Try
      Reg.GetKeyNames(SubKeyNames);
      for Name in SubKeyNames do
        // oracle 10 save path to ORACLE_HOME in registry key like this
        // HKEY_LOCAL_MACHINE\SOFTWARE\ORACLE\KEY_OraClient10g_home1\ORACLE_HOME
        // for oracle 8 and 9 another key
        if pos('KEY_', Name) = 1 then
        begin
          Reg.OpenKeyReadOnly(Name);
          // for oracle 10 path to tnsnames.ora like this
          // %ORACLE_HOME%\NETWORK\ADMIN\tnsnames.ora
          // for oracle 8 and 9 another path
          Result := Reg.ReadString('ORACLE_HOME') +
            '\NETWORK\ADMIN\tnsnames.ora';
        end;
    Finally
      SubKeyNames.Free;
    End;
  Finally
    Reg.Free;
  End;
end;

function TPrincipal.GetTotalMemory: Double;
var
  MemStatus: TMemoryStatusEx;
begin
  MemStatus.dwLength := SizeOf(TMemoryStatusEx);
  if GlobalMemoryStatusEx(MemStatus) then
    Result := MemStatus.ullTotalPhys / (1024 * 1024 * 1024)
  else
    Result := -1;
end;

procedure TPrincipal.LstPrincipalDrawItem(Control: TWinControl; Index: Integer;
  Rect: TRect; State: TOwnerDrawState);
var
  Obj: TCorItem;
begin
  Obj := TCorItem(LstPrincipal.Items.Objects[Index]);

  with LstPrincipal.Canvas do
  begin
    Brush.Color := Obj.Cor;
    FillRect(Rect);

    Font.Name := 'Segoe UI';
    Font.Size := 8;
    Font.Color := clBlack;

    if odSelected in State then
    begin
      Brush.Color := clNavy;
      FillRect(Rect);
      Font.Color := clWhite;
    end;

    // TextOut(Rect.Left + 10, Rect.Top + 6, LstPrincipal.Items[Index]);
    TextOut(Rect.Left + 2, Rect.Top + 1, LstPrincipal.Items[Index]);
  end;
end;

procedure TPrincipal.LstPrincipalClick(Sender: TObject);
var
  Obj: TCorItem;
  TextoSelecionado: string;
begin
  MemoResult.Clear;

  if LstPrincipal.ItemIndex < 0 then
    Exit;

  TextoSelecionado := LstPrincipal.Items[LstPrincipal.ItemIndex];
  Obj := TCorItem(LstPrincipal.Items.Objects[LstPrincipal.ItemIndex]);

  if Assigned(Obj) and (Trim(Obj.Detalhes) <> '') then
    MemoResult.Lines.Add(Obj.Detalhes)
  else
    MemoResult.Lines.Add('Detalhes da linha selecionada: ' + TextoSelecionado);
end;

procedure TPrincipal.btnStartClick(Sender: TObject);
Var
  sQry, sQry1: TFDQuery;
  sListaMensagens: TStringList;
  nPortaServidor, nTamanhoInput, nTamanhoOutput, A, nContErro, UsoProcesso,
    nTotalDisco, nTotalProc, TotalErros: Integer;
  Retorno, sIPServidor, sIPLocal, sPreReq: String;
  TempoInicial: TDateTime;
  nTotalMemoria: Double;

begin
  try
    A := 0;
    nContErro := 0;
    nPortaServidor := 0;
    nTamanhoInput := 0;
    nTamanhoOutput := 0;
    nContErro := 0;
    nTotalMemoria := 0;
    TotalErros := 0;
    TempoInicial := Time();
    sIPLocal := '';
    sIPServidor := '';
    sListaMensagens := TStringList.Create;
    sListaMensagens.Clear;

    // Informações Hardware Servidor
    nTotalProc := GetProcessorCoreCount;
    nTotalMemoria := GetTotalMemory;
    nTotalDisco := EspacoEmDiscoLivre();

    sQry := TFDQuery.Create(Nil);
    sQry.Connection := dm.fdc;
    sQry.SQL.Clear;

    sQry1 := TFDQuery.Create(Nil);
    sQry1.Connection := dm.fdc;
    sQry1.SQL.Clear;

    LimparItensLista;
    MemoResult.Clear;

    LimparItensLista;
    VerificaEstrutura;

    AdicionarItem('INFORMAÇÕES DO HARDWARE DO SERVIDOR', '', clGray);
    AdicionarItem('Informações do processador : ' + GetProcessorName,
      'Dentro dos pre requisitos', clSilver);

    AdicionarItem('Quantidade núcleos processador : ' + IntToStr(nTotalProc),
      'Quantidade de nucleos do processador', clSilver);

    AdicionarItem('Informações Memória RAM : ' + FormatFloat('0.00',
      nTotalMemoria) + ' GB', 'Quantidade de memória total', clSilver);

    AdicionarItem('Espaço livre em disco : ' + IntToStr(nTotalDisco) + ' GB',
      'Quantidade de espaço em disco disponível para uso', clSilver);

    // Qtd PDVs Ativos
    sQry.SQL.Clear;
    sQry.SQL.Add('select nvl(count(1),0) qtdePDV from ' +
      sUsuarioConsincoMonitor + '.tb_checkout a where a.ativo = ''S''');
    sQry.open;

    if not ValidarInfraestrutura(sQry.FieldByName('qtdePDV').AsInteger,
      GetProcessorCoreCount, EspacoEmDiscoLivre(), GetTotalMemory, sPreReq) then
    begin
      AdicionarItem('Pré Requisitos : Servidor fora dos pré requisitos ',
        sPreReq, clWebSalmon);
    end
    else
      AdicionarItem('Pré Requisitos', ' Servidor dentro dos pré requisitos ',
        clSilver);

    // Verificar IP do servidor.
    // I.P. Local da maquina

    // AdicionarItem('', '', clNone);
    AdicionarItem('INFORMAÇÕES DO AMBIENTE DO SERVIDOR', '', clGray);
    sIPLocal := Trim(GetLocalIP);
    sQry.SQL.Clear;
    sQry.SQL.Add('select to_Char(' + sUsuarioConsincoMonitor +
      '.fn_getparametromonitor(''ServidorLocal'',''IP'')) IPServidor from dual');
    sQry.open;

    // I.P. Configurado no servidor
    sIPServidor := Trim(sQry.FieldByName('IPServidor').AsString);

    AdicionarItem('I.P. Servidor : ' + ValorNaoNulo(sIPServidor, sIPLocal),
      'Configurações -> Configurações de XXXXX', clSilver);

    if sIPServidor <> '' then
    begin
      AdicionarItem('I.P. Servidor : ' + ValorNaoNulo(sIPServidor, sIPLocal),
        'Existe endereço I.P. configurado nas configurações de "Servidor Local" do servidor de PDVs, ('
        + sIPServidor +
        ') isto faz com que o serviço se baseie neste I.P. configurado para inicialização, e não no I.P. da máquina local. ',
        clbLUE);
    end;
    if sIPServidor <> '' then
      if sIPServidor <> sIPLocal then
      begin
        AdicionarItem('I.P. Servidor : ' + sIPServidor,
          'O endereço I.P. configurado nas configurações de "Servidor Local" do servidor de PDVs, está DIFERENTE do I.P. da máquina do servidor, isto causará problemas na inicialização do serviço do servidor de PDVs.'
          + 'I.P. Configurado : ' + sIPServidor +
          ' - I.P. da máquina do servidor : ' + sIPLocal +
          'Exclua o I.P. configurado das configurações de "Servidor Local" do servidor de PDVs, para que a aplicação considere o I.P. da máquina local, ou então configure o I.P. corretamente para evitar problemas na comunicação com os PDVs',
          clWebSalmon);
      end;

    // Verificar porta do servidor
    sQry.SQL.Clear;
    sQry.SQL.Add('select nvl(to_Char(' + sUsuarioConsincoMonitor +
      '.fn_getparametromonitor(''ServidorLocal'',''Port'')),7011) PortaServidor from dual');
    sQry.open;
    nPortaServidor := sQry.FieldByName('PortaServidor').AsInteger;
    if nPortaServidor <> 7011 then
    begin
      AdicionarItem('Porta comunicação servidor : ' + IntToStr(nPortaServidor),
        'Porta de comunicação do serviço do servidor de PDVS está configurada como : '
        + IntToStr(nPortaServidor) +
        ', que é diferente do padrão 7011, isto poderá causar problemas de comunicação com os PDVs , configure a porta do serviço nas configurações de "Servidor Local" do servidor de PDVs, para 7011 ',
        clWebSalmon);
    end
    else
      AdicionarItem('Porta comunicação servidor : ' + IntToStr(nPortaServidor),
        'Porta : ' + IntToStr(nPortaServidor), clSilver);

    // cleber
    AdicionarItem('Teste de conexão local com servidor : ',
      'Verificando conectividade local do servidor de PDVs (Telnet) com o I.P configurado ou da máquina local -> '
      + ValorNaoNulo(sIPServidor, sIPLocal) + ' Porta : ' +
      IntToStr(nPortaServidor) + ' : ' + TestaConexao(ValorNaoNulo(sIPServidor,
      sIPLocal), nPortaServidor), clSilver);

    { AdicionarItem('Teste de conexão local com servidor : ',
      'Verificando conectividade local do servidor de PDVs (Telnet) com o I.P da máquina local -> '
      + ValorNaoNulo(Trim(sQry.FieldByName('IPServidor').AsString),
      Trim(GetLocalIP)) + ' Porta : ' + sQry.FieldByName('PortaServidor')
      .AsString + TestaConexao(ValorNaoNulo(Trim(sQry.FieldByName('IPServidor')
      .AsString), sQry.FieldByName('PortaServidor').AsString)), clSilver);
    }

    { function ValidarInfraestrutura(pdv, cpu, disco: Integer; memoria: Double;
      out Mensagem: string): Boolean;
    }

    // Parametros do  monitor
    AdicionarItem('VERIFICANDO INFORMAÇÕES DE PARAMETROS DO SERVIDOR DE PDVS',
      '', clGray);

    sListaMensagens.Clear;
    Retorno := GetParametroMonitor('ExportarMovimento', 'Ativo');
    sListaMensagens.Text :=
      'Configurações -> Configurações de servidor de PDVs -> Exportar Movimento : '
      + iif(Retorno = 'SIM',
      'Parametro ativo, movimentações serão exportadas normalmente para o ERP',
      'Parametro configurado como NÃO, desta forma movimentações de PDV, NÃO serão exportadas para o ERP');
    AdicionarItem('Exporta Movimento : ' + Retorno, sListaMensagens.Text,
      iif(Retorno <> 'SIM', clWebSalmon, clSilver));

    sListaMensagens.Clear;
    Retorno := GetParametroMonitor('ReceberMovimento', 'Ativo');
    sListaMensagens.Text :=
      'Configurações -> Configurações de servidor de PDVs -> Receber movimento : '
      + iif(Retorno = 'SIM',
      'Parametro ativo, movimentações do PDV serão enviadas para o servidor de PDVs',
      'Parametro configurado como NÃO, desta forma movimentações de PDV, NÃO serão exportadas para o servidor de PDVS');
    AdicionarItem('Receber Movimento : ' + Retorno, sListaMensagens.Text,
      iif(Retorno <> 'SIM', clWebSalmon, clSilver));

    sListaMensagens.Clear;
    Retorno := GetParametroMonitor('GerarCargaMonitor', 'Ativo');
    sListaMensagens.Text :=
      'Configurações -> Configurações de servidor de PDVs -> Cargas -> Gerar Carga Local : '
      + iif(Retorno = 'SIM',
      'Parametro ativo, geração de carga para o servidor de PDVs serão geradas normalmente',
      'Parametro configurado como NÃO, cargas de cadastro NÃO serão geradas do ERP para o servidor de PDVs para ativar a geração, ajuste o parametro em ');
    AdicionarItem('Gera Carga Monitor : ' + Retorno, sListaMensagens.Text,
      iif(Retorno <> 'SIM', clWebSalmon, clSilver));

    sListaMensagens.Clear;
    Retorno := GetParametroMonitor('GerarCargaPDV', 'Ativo');
    sListaMensagens.Text :=
      'Configurações -> Configurações de servidor de PDVs -> Cargas -> Gerar Carga para PDVs : '
      + iif(Retorno = 'SIM',
      'Parametro ativo, geração de carga para os PDVs serão geradas normalmente',
      'Parametro configurado como NÃO, cargas de cadastro NÃO serão geradas do servidor de PDVs para os PDVs');
    AdicionarItem('Gera Carga PDVs : ' + Retorno, sListaMensagens.Text,
      iif(Retorno <> 'SIM', clWebSalmon, clSilver));

    sListaMensagens.Clear;
    Retorno := GetParametroMonitor('EnviarCargaPDV', 'Ativo');
    sListaMensagens.Text :=
      'Configurações -> Configurações de servidor de PDVs -> Cargas -> Enviar Carga para PDVs'
      + iif(Retorno = 'SIM',
      'Parametro ativo, envio de carga para os PDVs ocorrerão normalmente',
      'Parametro configurado como NÃO, cargas de cadastro NÃO serão enviadas do servidor para os PDVs');
    AdicionarItem('Envia Carga PDVs : ' + Retorno, sListaMensagens.Text,
      iif(Retorno <> 'SIM', clWebSalmon, clSilver));

    sListaMensagens.Clear;
    Retorno := GetParametroMonitor('Geral', 'Integracao');
