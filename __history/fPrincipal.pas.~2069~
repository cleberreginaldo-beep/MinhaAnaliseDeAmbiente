function TPrincipal.GetLocalIP: string;
var
  WSAData: TWSAData;
  HostName: array [0 .. 255] of AnsiChar;
  HostEnt: PHostEnt;
  Addr: PAnsiChar;
begin
  Result := '';
  if WSAStartup(MakeWord(2, 2), WSAData) = 0 then
  begin
    try
      if gethostname(HostName, SizeOf(HostName)) = 0 then
      begin
        HostEnt := gethostbyname(HostName);
        if Assigned(HostEnt) then
        begin
          Addr := inet_ntoa(PInAddr(HostEnt^.h_addr_list^)^);
          if Assigned(Addr) then
            Result := string(Addr);
        end;
      end;
    finally
      WSACleanup;
    end;
  end;
end;

function TPrincipal.GetParametroMonitor(pGrupo, pParam: String): String;
Var
  Qry: TFDQuery;
begin
  try

    Qry := TFDQuery.Create(Nil);
    Qry.Connection := dm.fdc;
    Qry.SQL.Clear;

    Qry.SQL.Add('select case ' + ' when valor = ''S'' then ''SIM''' +
      ' when valor = ''N'' then ''NAO''' + ' else valor ' + ' end as retorno ' +
      ' from ( ' + '    select to_char(' + sUsuarioConsincoMonitor +
      '.fn_getparametromonitor(' + QuotedStr(pGrupo) + ',' + QuotedStr(pParam) +
      ')) valor' + '    from dual) ');

    { Qry.SQL.Add('select case ' + ' when valor = ''S'' then ''SIM''' +
      ' when valor = ''N'' then ''NAO''' + ' else valor ' + ' end as retorno ' +
      ' from ( ' + '    select to_char(monitorpdv.fn_getparametromonitor(' +
      QuotedStr(pGrupo) + ',' + QuotedStr(pParam) + ')) valor' +
      '    from dual) ');
    }

    Qry.open;
    Result := Qry.FieldByName('Retorno').AsString;

  finally
    FreeAndNil(Qry);
  end;

end;

