// Função auxiliar para converter a data do WMI (formato YYYYMMDDHHMMSS.000000-000) para TDateTime
function WmiDateToDateTime(const AWmiDate: string): TDateTime;
begin
  if Length(AWmiDate) >= 14 then
  begin
    try
      Result := EncodeDateTime(StrToInt(Copy(AWmiDate, 1, 4)), // Ano
        StrToInt(Copy(AWmiDate, 5, 2)), // Mês
        StrToInt(Copy(AWmiDate, 7, 2)), // Dia
        StrToInt(Copy(AWmiDate, 9, 2)), // Hora
        StrToInt(Copy(AWmiDate, 11, 2)), // Minuto
        StrToInt(Copy(AWmiDate, 13, 2)), // Segundo
        0);
    except
      Result := 0;
    end;
  end
  else
    Result := 0;
end;

procedure TPrincipal.BuscarEventosWindows(const NomeAplicacao: string;
  MemoDestino: TMemo);
var
  SWbemLocator: OLEVariant;
  WMIService: OLEVariant;
  WbemObjectSet: OLEVariant;
  WbemObject: OLEVariant;
  Enum: IEnumVariant;
  Value: LongWord;
  WQL: string;
  DataGeracao, DataLimite: TDateTime;
  StrDataWMI: string;
begin
  MemoDestino.Clear;
  MemoDestino.Lines.Add('Buscando falhas dos últimos 7 dias para: ' +
    NomeAplicacao + '...');
  application.ProcessMessages;

  // Calcula a data limite: Hoje menos 7 dias
  DataLimite := IncDay(now, -7);
  // Converte para o formato exigido pelo WMI (Ex: 20231025143000.000000-000)
  StrDataWMI := FormatDateTime('yyyymmddhhnnss', DataLimite) + '.000000-000';

  CoInitialize(nil);
  try
    try
      SWbemLocator := CreateOleObject('WbemScripting.SWbemLocator');
      WMIService := SWbemLocator.ConnectServer('localhost',
        'root\CIMV2', '', '');

      // AJUSTES NA QUERY:
      // 1. TimeGenerated >= StrDataWMI (Últimos 7 dias)
      // 2. EventType = 1 (Traz apenas Erros/Falhas)
      WQL := 'SELECT * FROM Win32_NTLogEvent ' +
        'WHERE (Logfile = ''Application'' OR Logfile = ''Security'') ' +
        'AND EventType = 1 ' + 'AND TimeGenerated >= ''' + StrDataWMI + ''' ' +
        'AND (SourceName = ''' + NomeAplicacao + ''' OR Message LIKE ''%' +
        NomeAplicacao + '%'')';

      WbemObjectSet := WMIService.ExecQuery(WQL);
      Enum := IUnknown(WbemObjectSet._NewEnum) as IEnumVariant;

      // MemoDestino.Clear;

      while Enum.Next(1, WbemObject, Value) = 0 do
      begin
        // Converte a data do WMI (YYYYMMDDHHMMSS.000000-000)
        try
          DataGeracao := EncodeDateTime
            (StrToInt(Copy(VarToStr(WbemObject.TimeGenerated), 1, 4)),
            StrToInt(Copy(VarToStr(WbemObject.TimeGenerated), 5, 2)),
            StrToInt(Copy(VarToStr(WbemObject.TimeGenerated), 7, 2)),
            StrToInt(Copy(VarToStr(WbemObject.TimeGenerated), 9, 2)),
            StrToInt(Copy(VarToStr(WbemObject.TimeGenerated), 11, 2)),
            StrToInt(Copy(VarToStr(WbemObject.TimeGenerated), 13, 2)), 0);
        except
          DataGeracao := 0;
        end;

        MemoDestino.Lines.Add('Log: ' + VarToStr(WbemObject.Logfile));
        MemoDestino.Lines.Add('Data/Hora: ' + DateTimeToStr(DataGeracao));
        MemoDestino.Lines.Add('Fonte: ' + VarToStr(WbemObject.SourceName));
        MemoDestino.Lines.Add('Mensagem: ' +
          Trim(VarToStr(WbemObject.Message)));
        MemoDestino.Lines.Add(StringOfChar('-', 50));

        WbemObject := Unassigned;
      end;

      if MemoDestino.Lines.Count = 0 then
        MemoDestino.Lines.Add
          ('Nenhuma falha encontrada nos últimos 7 dias para o aplicativo: ' +
          NomeAplicacao);

    except
      on E: Exception do
        MemoDestino.Lines.Add('Erro ao consultar WMI: ' + E.Message);
    end;
  finally
    CoUninitialize;
  end;
end;

function TPrincipal.ContarErrosAplicacao(const NomeAplicacao: string): Integer;
var
  SWbemLocator: OLEVariant;
  WMIService: OLEVariant;
  WbemObjectSet: OLEVariant;
  WQL: string;
  DataLimite: TDateTime;
  StrDataWMI: string;
begin
  Result := 0;

  // Calcula a data atual menos 7 dias
  DataLimite := IncDay(now, -7);

  // Converte a data do Delphi para o formato do WMI: YYYYMMDDHHMMSS.000000-000
  StrDataWMI := FormatDateTime('yyyymmddhhnnss', DataLimite) + '.000000-000';

  CoInitialize(nil);
  try
    try
      SWbemLocator := CreateOleObject('WbemScripting.SWbemLocator');
      WMIService := SWbemLocator.ConnectServer('localhost',
        'root\CIMV2', '', '');

      // Monta a consulta (WQL):
      // - Logfile = 'Application' ou 'System'
      // - EventType = 1 (1 representa "Erro/Falha" no Windows)
      // - TimeGenerated >= DataLimite (Últimos 7 dias)
      // - SourceName ou Message contendo o nome da aplicação
      WQL := Format('SELECT * FROM Win32_NTLogEvent ' +
        'WHERE (Logfile = ''Application'' OR Logfile = ''System'') ' +
        'AND EventType = 1 ' + 'AND TimeGenerated >= ''%s'' ' +
        'AND (SourceName = ''%s'' OR Message LIKE ''%%%s%%'')',
        [StrDataWMI, NomeAplicacao, NomeAplicacao]);

      // Executa a consulta
      WbemObjectSet := WMIService.ExecQuery(WQL);

      // Retorna a contagem exata de registros encontrados
      Result := WbemObjectSet.Count;

    except
      on E: Exception do
      begin
        // Em caso de falha de permissão ou erro do WMI, retorna -1
        Result := -1;
      end;
    end;
  finally
    CoUninitialize;
  end;
end;


