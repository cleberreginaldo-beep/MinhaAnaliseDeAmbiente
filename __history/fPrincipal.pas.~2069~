    end;

    sQry.SQL.Clear;
    sQry.SQL.Add
      ('select a.tablespace_name,Round(USED_PERCENT, 2) PercUso from DBA_TABLESPACE_USAGE_METRICS a order by 2');
    sQry.open;
    if sQry.RecordCount > 0 then
      while not sQry.Eof do
      begin
        if sQry.FieldByName('PercUso').AsInteger >= 90 then
